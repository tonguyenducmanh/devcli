          "group": "2_edit@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.merge",
          "group": "3_history@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.rebase",
          "group": "3_history@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.pickBranch",
          "group": "4_other@1",
          "when": "scmProvider == tm"
        }
      ],
      "tm.stash": [
        {
          "command": "tm.stash",
          "group": "1_save@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashIncludeUntracked",
          "group": "1_save@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashPop",
          "group": "2_restore@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashPopLatest",
          "group": "2_restore@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashApply",
          "group": "2_restore@3",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashApplyLatest",
          "group": "2_restore@4",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashDrop",
          "group": "3_drop@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stashDropAll",
          "group": "3_drop@2",
          "when": "scmProvider == tm"
        }
      ],
      "tm.tags": [
