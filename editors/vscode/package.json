{
  "name": "tm-vcs",
  "displayName": "To Manh Version Control System",
  "description": "Quản lý phiên bản mã nguồn cục bộ bằng tm trong VS Code",
  "version": "0.1.1",
  "publisher": "tm",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "tm",
    "vcs",
    "git",
    "source control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "tm chỉ chạy trên kho đã có sẵn trong workspace, không chạy mã do kho cung cấp."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "tm cần đọc cây làm việc trên đĩa nên không dùng được trong workspace ảo."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "ignore",
        "aliases": [
          "TM Ignore",
          "tm-ignore"
        ],
        "extensions": [
          ".tmxignore"
        ],
        "filenamePatterns": [
          "**/.tmx/info/exclude"
        ]
      }
    ],
    "commands": [
      {
        "command": "tm.refresh",
        "title": "%command.refresh%",
        "category": "TM",
        "icon": "$(refresh)"
      },
      {
        "command": "tm.init",
        "title": "%command.init%",
        "category": "TM",
        "icon": "$(repo)"
      },
      {
        "command": "tm.commit",
        "title": "%command.commit%",
        "category": "TM",
