          "group": "1_modification"
        },
        {
          "command": "tm.stageAllMerge",
          "when": "scmProvider == tm && scmResourceGroup == merge",
          "group": "inline@2"
        }
      ],
      "scm/resourceState/context": [
        {
          "command": "tm.openChange",
          "when": "scmProvider == tm && scmResourceGroup =~ /^(index|workingTree)$/",
          "group": "navigation"
        },
        {
          "command": "tm.openFile",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "navigation"
        },
        {
          "command": "tm.openChange",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "1_open@1"
        },
        {
          "command": "tm.openFile",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "1_open@2"
        },
        {
          "command": "tm.openHEADFile",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "1_open@3"
        },
        {
          "command": "tm.unstage",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "2_modification@1"
        },
        {
          "command": "tm.unstage",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "inline@2"
        },
        {
          "command": "tm.openChange",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "1_open@1"
        },
        {
          "command": "tm.openFile",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "1_open@2"
        },
        {
          "command": "tm.openHEADFile",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "1_open@3"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "2_modification@1"
        },
        {
          "command": "tm.revertChange",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "2_modification@2"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "inline@2"
        },
        {
          "command": "tm.revertChange",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "inline@2"
        },
        {
          "command": "tm.openChange",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "1_open@1"
        },
        {
          "command": "tm.openFile",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "1_open@2"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "2_modification@1"
        },
        {
          "command": "tm.revertChange",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "2_modification@2"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "inline@2"
        },
        {
          "command": "tm.revertChange",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "inline@2"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == merge",
          "group": "2_modification@1"
        },
        {
          "command": "tm.openChange",
          "when": "scmProvider == tm && scmResourceGroup == merge",
          "group": "1_open@1"
        },
        {
          "command": "tm.openFile",
          "when": "scmProvider == tm && scmResourceGroup == merge",
          "group": "1_open@2"
        },
        {
          "command": "tm.stage",
          "when": "scmProvider == tm && scmResourceGroup == merge",
          "group": "inline@2"
        },
        {
          "command": "tm.revealInExplorer",
          "when": "scmProvider == tm && scmResourceGroup =~ /^(index|workingTree|untracked|merge)$/",
          "group": "3_view@1"
        },
        {
          "command": "tm.fileHistory",
          "when": "scmProvider == tm && scmResourceGroup =~ /^(index|workingTree|untracked|merge)$/",
          "group": "3_view@2"
        }
      ],
      "editor/title": [
        {
          "command": "tm.openFile",
          "group": "navigation",
          "when": "scmProvider == tm && isInDiffEditor && resourceScheme == tm"
        },
        {
          "command": "tm.openChange",
          "group": "navigation",
          "when": "scmProvider == tm && !isInDiffEditor && resourceScheme == file && scmActiveResourceHasChanges"
        }
      ],
      "editor/title/context": [
        {
          "command": "tm.fileHistory",
          "group": "1_view@1",
          "when": "tm.openRepositoryCount > 0 && resourceScheme == file"
        }
      ],
      "explorer/context": [
        {
          "command": "tm.fileHistory",
          "group": "7_modification@1",
          "when": "tm.openRepositoryCount > 0"
        }
      ],
      "view/title": [
        {
          "command": "tm.refresh",
          "group": "navigation",
          "when": "view == tmBranches || view == tmCommits || view == tmStashes || view == tmTags"
        },
        {
          "command": "tm.branch",
          "group": "navigation",
          "when": "view == tmBranches"
        },
        {
          "command": "tm.stash",
          "group": "navigation",
          "when": "view == tmStashes"
        },
        {
          "command": "tm.tag",
          "group": "navigation",
          "when": "view == tmTags"
        },
        {
          "command": "tm.pickCommit",
          "group": "navigation@1",
          "when": "view == tmCommits"
        }
      ],
      "view/item/context": [
        {
          "command": "tm.checkout",
          "group": "1_modification@1",
          "when": "view == tmBranches && viewItem =~ /^branch/",
          "alt": "tm.merge"
        },
        {
          "command": "tm.merge",
          "group": "1_modification@2",
          "when": "view == tmBranches && viewItem =~ /^branch/"
        },
        {
          "command": "tm.rebase",
          "group": "1_modification@3",
          "when": "view == tmBranches && viewItem =~ /^branch/"
        },
        {
          "command": "tm.renameBranch",
          "group": "2_modify@1",
          "when": "view == tmBranches && viewItem =~ /^branch/"
        },
        {
          "command": "tm.deleteBranch",
          "group": "2_modify@2",
          "when": "view == tmBranches && viewItem =~ /^branch/"
        },
        {
          "command": "tm.openCommitChanges",
          "group": "1_modification@1",
          "when": "view == tmCommits && viewItem == commit"
        },
        {
          "command": "tm.checkout",
          "group": "1_modification@2",
          "when": "view == tmCommits && viewItem == commit"
        },
        {
          "command": "tm.revert",
          "group": "1_modification@3",
          "when": "view == tmCommits && viewItem == commit"
        },
        {
          "command": "tm.cherryPick",
          "group": "1_modification@4",
          "when": "view == tmCommits && viewItem == commit"
        },
        {
          "command": "tm.tag",
          "group": "2_new@1",
          "when": "view == tmCommits && viewItem == commit"
        },
        {
          "command": "tm.stashPop",
          "group": "1_modification@1",
          "when": "view == tmStashes && viewItem == stash"
        },
        {
          "command": "tm.stashApply",
          "group": "1_modification@2",
          "when": "view == tmStashes && viewItem == stash"
        },
        {
          "command": "tm.stashDrop",
          "group": "2_drop@1",
          "when": "view == tmStashes && viewItem == stash"
        },
        {
          "command": "tm.deleteTag",
          "group": "1_modification@1",
          "when": "view == tmTags && viewItem == tag"
        },
        {
          "command": "tm.checkout",
          "group": "1_modification@2",
          "when": "view == tmTags && viewItem == tag"
        }
      ],
