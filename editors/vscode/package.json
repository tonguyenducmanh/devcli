      },
      {
        "command": "tm.branchFrom",
        "title": "%command.branchFrom%",
        "category": "TM"
      },
      {
        "command": "tm.deleteBranch",
        "title": "%command.deleteBranch%",
        "category": "TM"
      },
      {
        "command": "tm.renameBranch",
        "title": "%command.renameBranch%",
        "category": "TM"
      },
      {
        "command": "tm.merge",
        "title": "%command.merge%",
        "category": "TM"
      },
      {
        "command": "tm.rebase",
        "title": "%command.rebase%",
        "category": "TM"
      },
      {
        "command": "tm.cherryPick",
        "title": "%command.cherryPick%",
        "category": "TM"
      },
      {
        "command": "tm.revert",
        "title": "%command.revert%",
        "category": "TM"
      },
      {
        "command": "tm.stash",
        "title": "%command.stash%",
        "category": "TM"
      },
      {
        "command": "tm.stashIncludeUntracked",
        "title": "%command.stashIncludeUntracked%",
        "category": "TM"
      },
      {
        "command": "tm.stashApply",
        "title": "%command.stashApply%",
        "category": "TM"
      },
      {
        "command": "tm.stashApplyLatest",
        "title": "%command.stashApplyLatest%",
        "category": "TM"
      },
      {
        "command": "tm.stashPop",
        "title": "%command.stashPop%",
        "category": "TM"
      },
      {
        "command": "tm.stashPopLatest",
        "title": "%command.stashPopLatest%",
        "category": "TM"
      },
      {
        "command": "tm.stashDrop",
        "title": "%command.stashDrop%",
        "category": "TM"
      },
      {
        "command": "tm.stashDropAll",
        "title": "%command.stashDropAll%",
        "category": "TM"
      },
      {
        "command": "tm.tag",
        "title": "%command.tag%",
        "category": "TM"
      },
      {
        "command": "tm.deleteTag",
        "title": "%command.deleteTag%",
        "category": "TM"
      },
      {
        "command": "tm.revealInExplorer",
        "title": "%command.revealInExplorer%",
        "category": "TM"
      },
      {
        "command": "tm.showOutput",
        "title": "%command.showOutput%",
        "category": "TM"
      },
      {
        "command": "tm.pickCommit",
        "title": "%command.pickCommit%",
        "category": "TM",
        "icon": "$(history)"
      },
      {
        "command": "tm.pickBranch",
