    "configuration": [
      {
        "title": "TM",
        "properties": {
          "tm.path": {
            "type": "string",
            "default": "tm",
            "markdownDescription": "Đường dẫn tới tệp thực thi `tm`. Để trống nghĩa là tự tìm trong `PATH`, `~/go/bin`, `~/bin` và các thư mục hệ thống."
          },
          "tm.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Bật tìm kho tm trong workspace."
          },
          "tm.autoRefresh": {
            "type": "boolean",
            "default": true,
            "description": "Tự làm mới trạng thái khi tệp trên đĩa thay đổi."
          },
          "tm.autorefreshDelay": {
            "type": "number",
            "default": 1000,
            "minimum": 0,
            "maximum": 60000,
            "description": "Số mili giây chờ trước khi làm mới sau lần thay đổi tệp cuối cùng."
          },
          "tm.decorations.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Hiện chữ viết tắt M/A/D/U trên tên tệp trong cây thư mục và trình soạn thảo."
          },
          "tm.showCommitInput": {
            "type": "boolean",
            "default": true,
            "description": "Hiện ô nhập nội dung commit trong khung Source Control."
          },
          "tm.alwaysShowStagedChangesResourceGroup": {
            "type": "boolean",
            "default": true,
            "description": "Luôn hiện nhóm Staged Changes dù không có tệp nào."
          },
          "tm.openDiffOnClick": {
            "type": "boolean",
            "default": true,
            "description": "Bấm vào tệp trong khung Source Control thì mở khung so sánh thay vì mở thẳng tệp. Tắt đi để bấm là mở tệp."
          },
          "tm.confirmEmptyCommits": {
            "type": "boolean",
            "default": true,
            "description": "Hỏi lại trước khi tạo commit rỗng."
          },
          "tm.logMaxCount": {
            "type": "number",
            "default": 500,
            "minimum": 10,
            "description": "Số commit tối đa hiển thị trong khung Commits."
          }
        }
      }
