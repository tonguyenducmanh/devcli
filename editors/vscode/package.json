        "title": "%command.commitStaged%",
        "category": "TM"
      },
      {
        "command": "tm.commitAmend",
        "title": "%command.commitAmend%",
        "category": "TM"
      },
      {
        "command": "tm.commitStagedAmend",
        "title": "%command.commitStagedAmend%",
        "category": "TM"
      },
      {
        "command": "tm.commitEmpty",
        "title": "%command.commitEmpty%",
        "category": "TM"
      },
      {
        "command": "tm.stage",
        "title": "%command.stage%",
        "category": "TM",
        "icon": "$(add)"
      },
      {
        "command": "tm.stageAll",
        "title": "%command.stageAll%",
        "category": "TM",
        "icon": "$(add)"
      },
      {
        "command": "tm.stageAllTracked",
        "title": "%command.stageAllTracked%",
        "category": "TM",
        "icon": "$(add)"
      },
      {
        "command": "tm.stageAllUntracked",
        "title": "%command.stageAllUntracked%",
        "category": "TM",
        "icon": "$(add)"
      },
      {
        "command": "tm.stageAllMerge",
        "title": "%command.stageAllMerge%",
        "category": "TM",
        "icon": "$(add)"
      },
      {
        "command": "tm.unstage",
        "title": "%command.unstage%",
        "category": "TM",
        "icon": "$(remove)"
      },
      {
        "command": "tm.unstageAll",
        "title": "%command.unstageAll%",
        "category": "TM",
        "icon": "$(remove)"
      },
      {
        "command": "tm.cleanAll",
        "title": "%command.cleanAll%",
        "category": "TM",
        "icon": "$(discard)"
      },
      {
        "command": "tm.cleanAllTracked",
        "title": "%command.cleanAllTracked%",
        "category": "TM",
        "icon": "$(discard)"
      },
      {
        "command": "tm.cleanAllUntracked",
        "title": "%command.cleanAllUntracked%",
        "category": "TM",
        "icon": "$(discard)"
      },
      {
        "command": "tm.revertChange",
        "title": "%command.revertChange%",
        "category": "TM",
        "icon": "$(discard)"
