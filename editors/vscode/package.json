        "category": "TM",
        "icon": "$(compare-changes)"
      },
      {
        "command": "tm.fileHistory",
        "title": "%command.fileHistory%",
        "category": "TM",
        "icon": "$(history)"
      }
    ],
    "submenus": [
      {
        "id": "tm.commit",
        "label": "%submenu.commit%"
      },
      {
        "id": "tm.changes",
        "label": "%submenu.changes%"
      },
      {
        "id": "tm.branch",
        "label": "%submenu.branch%"
      },
      {
        "id": "tm.stash",
        "label": "%submenu.stash%"
      },
      {
        "id": "tm.tags",
        "label": "%submenu.tags%"
      }
    ],
    "menus": {
      "scm/title": [
        {
          "command": "tm.commit",
          "group": "navigation",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.refresh",
          "group": "navigation",
          "when": "scmProvider == tm"
        },
        {
          "submenu": "tm.commit",
          "group": "2_main@1",
          "when": "scmProvider == tm"
        },
        {
          "submenu": "tm.changes",
          "group": "2_main@2",
          "when": "scmProvider == tm"
        },
        {
          "submenu": "tm.branch",
          "group": "2_main@3",
          "when": "scmProvider == tm"
        },
        {
          "submenu": "tm.stash",
          "group": "2_main@4",
          "when": "scmProvider == tm"
        },
        {
          "submenu": "tm.tags",
          "group": "2_main@5",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.showOutput",
          "group": "3_footer",
          "when": "scmProvider == tm"
        }
      ],
      "tm.commit": [
        {
          "command": "tm.commit",
          "group": "1_commit@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.commitAll",
          "group": "1_commit@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.commitStaged",
          "group": "1_commit@3",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.commitAmend",
          "group": "2_amend@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.commitStagedAmend",
          "group": "2_amend@2",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.commitEmpty",
          "group": "3_empty@1",
          "when": "scmProvider == tm"
        }
      ],
      "tm.changes": [
        {
          "command": "tm.stageAll",
          "group": "1_stage@1",
          "when": "scmProvider == tm"
        },
        {
          "command": "tm.stageAllTracked",
