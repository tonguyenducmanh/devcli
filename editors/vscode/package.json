      "editor/title": [
        {
          "command": "td.openFile",
          "group": "navigation",
          "when": "scmProvider == td && isInDiffEditor && resourceScheme == td"
        },
        {
          "command": "td.openChange",
          "group": "navigation",
          "when": "scmProvider == td && !isInDiffEditor && resourceScheme == file && scmActiveResourceHasChanges"
        }
      ],
      "view/title": [
        {
          "command": "td.refresh",
          "group": "navigation",
          "when": "view == tdBranches || view == tdCommits || view == tdStashes || view == tdTags"
        },
        {
          "command": "td.branch",
          "group": "navigation",
          "when": "view == tdBranches"
        },
        {
          "command": "td.stash",
          "group": "navigation",
          "when": "view == tdStashes"
        },
        {
          "command": "td.tag",
          "group": "navigation",
          "when": "view == tdTags"
        },
        {
          "command": "td.pickCommit",
