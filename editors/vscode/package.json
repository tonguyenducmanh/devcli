          "when": "scmProvider == tm"
        }
      ],
      "scm/resourceGroup/context": [
        {
          "command": "tm.unstageAll",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "1_modification"
        },
        {
          "command": "tm.unstageAll",
          "when": "scmProvider == tm && scmResourceGroup == index",
          "group": "inline@2"
        },
        {
          "command": "tm.cleanAll",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "1_modification"
        },
        {
          "command": "tm.stageAll",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "1_modification"
        },
        {
          "command": "tm.cleanAll",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "inline@2"
        },
        {
          "command": "tm.stageAll",
          "when": "scmProvider == tm && scmResourceGroup == workingTree",
          "group": "inline@2"
        },
        {
          "command": "tm.cleanAllUntracked",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "1_modification"
        },
        {
          "command": "tm.stageAllUntracked",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "1_modification"
        },
        {
          "command": "tm.cleanAllUntracked",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "inline@2"
        },
        {
          "command": "tm.stageAllUntracked",
          "when": "scmProvider == tm && scmResourceGroup == untracked",
          "group": "inline@2"
        },
        {
          "command": "tm.stageAllMerge",
