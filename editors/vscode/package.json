        "category": "TM",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tm.openFile2",
        "title": "%command.openFile%",
        "category": "TM",
        "icon": "$(go-to-file)"
      },
      {
        "command": "tm.openChange",
        "title": "%command.openChange%",
        "category": "TM",
        "icon": "$(compare-changes)"
      },
      {
        "command": "tm.openHEADFile",
        "title": "%command.openHEADFile%",
        "category": "TM"
      },
      {
        "command": "tm.checkout",
        "title": "%command.checkout%",
        "category": "TM"
      },
      {
        "command": "tm.branch",
