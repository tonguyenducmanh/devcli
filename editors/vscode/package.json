{
  "name": "td-vcs",
  "displayName": "TD VCS",
  "description": "Quản lý phiên bản mã nguồn cục bộ bằng td trong VS Code",
  "version": "0.1.0",
  "publisher": "td",
  "license": "MIT",
  "icon": "resources/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers"
  ],
  "keywords": [
    "td",
    "vcs",
    "git",
    "source control"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "td chỉ chạy trên kho đã có sẵn trong workspace, không chạy mã do kho cung cấp."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "td cần đọc cây làm việc trên đĩa nên không dùng được trong workspace ảo."
    }
  },
