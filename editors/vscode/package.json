    "views": {
      "scm": [
        {
          "id": "tdBranches",
          "name": "%view.branches%",
          "when": "td.openRepositoryCount > 0"
        },
        {
          "id": "tdCommits",
          "name": "%view.commits%",
          "when": "td.openRepositoryCount > 0"
        },
        {
          "id": "tdStashes",
          "name": "%view.stashes%",
          "when": "td.openRepositoryCount > 0"
        },
        {
          "id": "tdTags",
          "name": "%view.tags%",
          "when": "td.openRepositoryCount > 0"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "scm",
        "contents": "%view.welcome.noRepository%",
        "when": "!td.missing && !td.openRepositoryCount"
      },
      {
        "view": "scm",
        "contents": "%view.welcome.missingTd%",
        "when": "td.missing"
      },
      {
        "view": "tdBranches",
        "contents": "%view.welcome.noBranches%"
      },
      {
        "view": "tdCommits",
        "contents": "%view.welcome.noCommits%"
      },
      {
        "view": "tdStashes",
        "contents": "%view.welcome.noStashes%"
      },
      {
        "view": "tdTags",
        "contents": "%view.welcome.noTags%"
      }
    ],
    "configuration": [
      {
        "title": "TD",
        "properties": {
          "td.path": {
            "type": "string",
            "default": "td",
            "markdownDescription": "Đường dẫn tới tệp thực thi `td`. Để trống nghĩa là tự tìm trong `PATH`, `~/go/bin`, `~/bin` và các thư mục hệ thống."
          },
          "td.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Bật tìm kho td trong workspace."
          },
          "td.autoRefresh": {
            "type": "boolean",
            "default": true,
            "description": "Tự làm mới trạng thái khi tệp trên đĩa thay đổi."
          },
          "td.autorefreshDelay": {
            "type": "number",
            "default": 1000,
            "minimum": 0,
            "maximum": 60000,
            "description": "Số mili giây chờ trước khi làm mới sau lần thay đổi tệp cuối cùng."
          },
          "td.decorations.enabled": {
            "type": "boolean",
            "default": true,
            "description": "Hiện chữ viết tắt M/A/D/U trên tên tệp trong cây thư mục và trình soạn thảo."
          },
          "td.showCommitInput": {
            "type": "boolean",
            "default": true,
            "description": "Hiện ô nhập nội dung commit trong khung Source Control."
          },
          "td.alwaysShowStagedChangesResourceGroup": {
            "type": "boolean",
            "default": true,
            "description": "Luôn hiện nhóm Staged Changes dù không có tệp nào."
          },
          "td.openDiffOnClick": {
            "type": "boolean",
            "default": true,
            "description": "Bấm vào tệp trong khung Source Control thì mở khung so sánh thay vì mở thẳng tệp. Tắt đi để bấm là mở tệp."
          },
          "td.confirmEmptyCommits": {
            "type": "boolean",
            "default": true,
            "description": "Hỏi lại trước khi tạo commit rỗng."
          },
          "td.logMaxCount": {
            "type": "number",
            "default": 500,
            "minimum": 10,
            "description": "Số commit tối đa hiển thị trong khung Commits."
          }
        }
      }
    ],
